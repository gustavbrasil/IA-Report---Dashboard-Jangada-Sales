const RAW = RAWDATA.raw;          // array de vendas {d,v,m,t,c,p,val,av}
const MONTHS = RAWDATA.months;    // lista de meses YYYY-MM ordenados
const MARCAS = RAWDATA.marcas;
const TIPOS = RAWDATA.tipos;
const CONDICOES = RAWDATA.condicoes;

/* ===================== ESTADO DOS FILTROS ===================== */
const state = {
  monthFrom: MONTHS[0],
  monthTo: MONTHS[MONTHS.length-1],
  lineMetric: 'valor',
  vendedorMarca: '',
  pagamentoCondicao: '',
  marcaTipo: ''
};

/* ===================== HELPERS ===================== */
function formatBRL(v){
  return v.toLocaleString('pt-BR', {style:'currency', currency:'BRL', maximumFractionDigits:0});
}
function formatNum(v, dec=0){
  return v.toLocaleString('pt-BR', {minimumFractionDigits:dec, maximumFractionDigits:dec});
}
function monthLabelPtBr(ym){
  const [y,m] = ym.split('-');
  const meses = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return meses[parseInt(m,10)-1] + '/' + y.slice(2);
}
function inMonthRange(d){
  return d >= state.monthFrom && d <= state.monthTo;
}
function byMonthRange(){
  return RAW.filter(r => inMonthRange(r.d));
}

/* ===================== POPULAR SELECTS ===================== */
function populateMonthSelects(){
  const selFrom = document.getElementById('monthFrom');
  const selTo = document.getElementById('monthTo');
  MONTHS.forEach(m=>{
    const o1 = document.createElement('option'); o1.value=m; o1.textContent=monthLabelPtBr(m);
    selFrom.appendChild(o1);
    const o2 = document.createElement('option'); o2.value=m; o2.textContent=monthLabelPtBr(m);
    selTo.appendChild(o2);
  });
  selFrom.value = state.monthFrom;
  selTo.value = state.monthTo;
}
function populateFilterSelects(){
  const selVendMarca = document.getElementById('filterVendedorMarca');
  MARCAS.forEach(m=>{
    const o = document.createElement('option'); o.value=m; o.textContent=m;
    selVendMarca.appendChild(o);
  });
  const selCond = document.getElementById('filterPagamentoCondicao');
  CONDICOES.forEach(c=>{
    const o = document.createElement('option'); o.value=c; o.textContent=c;
    selCond.appendChild(o);
  });
  const selTipo = document.getElementById('filterMarcaTipo');
  TIPOS.forEach(t=>{
    const o = document.createElement('option'); o.value=t; o.textContent=t;
    selTipo.appendChild(o);
  });
}

/* ===================== KPIs ===================== */
function updateKPIs(){
  const filtered = byMonthRange();
  const total = filtered.length;
  const fatTotal = filtered.reduce((s,r)=>s+r.val,0);
  const ticket = total? fatTotal/total : 0;
  const avalMedia = total? filtered.reduce((s,r)=>s+r.av,0)/total : 0;

  document.getElementById('kpiFaturamento').textContent = formatBRL(fatTotal);
  document.getElementById('kpiTicket').textContent = formatBRL(ticket);
  document.getElementById('kpiVendas').textContent = formatNum(total);
  document.getElementById('kpiAvaliacao').textContent = total? formatNum(avalMedia,2) : '—';
  document.getElementById('totalRegistrosFooter').textContent = total;

  const rangeLabel = monthLabelPtBr(state.monthFrom) + ' – ' + monthLabelPtBr(state.monthTo);
  document.getElementById('kpiFaturamentoTrend').textContent = rangeLabel;
  document.getElementById('kpiTicketTrend').textContent = rangeLabel;
  document.getElementById('kpiVendasTrend').textContent = rangeLabel;
  document.getElementById('kpiAvaliacaoTrend').textContent = rangeLabel;
}

/* ===================== PALETA ===================== */
const PALETTE = ['#1e6fd9', '#0b3d91', '#4f9cf0', '#17a2a2', '#5fd0d0', '#8fc7f2', '#0d5aa7', '#2ea8a8', '#a9d6f5', '#093a70'];

/* ===================== SILHUETA DE LOGO POR MARCA (cores autenticas) ===================== */
/* Cada marca recebe um icone estilizado que remete ao formato e a cor
   caracteristica de sua logomarca oficial (estilo flat/silhueta simplificada).
   x,y = ponto central horizontal / base inferior do icone. w = largura do icone. */
const BRAND_STYLE = {
  'Volkswagen': {bg:'#001E50', fg:'#ffffff'},
  'Chevrolet':  {bg:'#ffffff', fg:'#c9a13b', stroke:'#c9a13b'},
  'Fiat':       {bg:'#8C1D2B', fg:'#ffffff'},
  'Toyota':     {bg:'#ffffff', fg:'#eb0a1e', stroke:'#eb0a1e'},
  'Hyundai':    {bg:'#00337A', fg:'#ffffff'},
  'Honda':      {bg:'#c8102e', fg:'#ffffff'},
  'Jeep':       {bg:'#0b3d24', fg:'#8fd694'},
  'Nissan':     {bg:'#ffffff', fg:'#1a1a1a', stroke:'#1a1a1a'},
  'Renault':    {bg:'#ffffff', fg:'#f2c94c', stroke:'#8a8a8a'},
  'Ford':       {bg:'#00338d', fg:'#ffffff'}
};

function drawBrandIcon(ctx, brand, x, y, w, fallbackColor){
  const size = w;
  const r = size/2;
  const midY = y - size/2;
  const style = BRAND_STYLE[brand] || {bg:fallbackColor, fg:'#ffffff'};

  ctx.save();
  ctx.lineCap='round';
  ctx.lineJoin='round';

  switch(brand){
    case 'Volkswagen': {
      ctx.beginPath(); ctx.arc(x, midY, r*0.92, 0, 2*Math.PI);
      ctx.fillStyle = style.bg; ctx.fill();
      ctx.strokeStyle='#ffffff'; ctx.lineWidth=Math.max(size*0.05,1); ctx.stroke();
      ctx.fillStyle = style.fg;
      ctx.font = `bold ${Math.round(size*0.42)}px Arial`;
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText('V', x-r*0.24, midY-r*0.06);
      ctx.fillText('W', x+r*0.28, midY+r*0.28);
      break;
    }
    case 'Chevrolet': {
      const bw=size*0.98, bh=size*0.36;
      ctx.fillStyle = style.fg;
      ctx.beginPath();
      ctx.moveTo(x-bw/2, midY-bh/2); ctx.lineTo(x, midY); ctx.lineTo(x-bw/2, midY+bh/2);
      ctx.lineTo(x-bw*0.30, midY); ctx.closePath(); ctx.fill();
      ctx.beginPath();
      ctx.moveTo(x+bw/2, midY-bh/2); ctx.lineTo(x, midY); ctx.lineTo(x+bw/2, midY+bh/2);
      ctx.lineTo(x+bw*0.30, midY); ctx.closePath(); ctx.fill();
      break;
    }
    case 'Toyota': {
      ctx.strokeStyle = style.stroke; ctx.lineWidth=Math.max(size*0.09,1.3);
      ctx.beginPath(); ctx.ellipse(x, midY, r*0.95, r*0.62, 0, 0, 2*Math.PI); ctx.stroke();
      ctx.beginPath(); ctx.ellipse(x, midY, r*0.34, r*0.62, 0, 0, 2*Math.PI); ctx.stroke();
      ctx.beginPath(); ctx.ellipse(x, midY, r*0.62, r*0.20, 0, 0, 2*Math.PI); ctx.stroke();
      break;
    }
    case 'Fiat': {
      const rr = size*0.24;
      ctx.fillStyle = style.bg;
      roundRect(ctx, x-r*1.05, midY-r*0.62, r*2.10, r*1.24, rr);
      ctx.fill();
      ctx.fillStyle = style.fg;
      ctx.font = `italic bold ${Math.round(size*0.32)}px Georgia, serif`;
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText('FIAT', x, midY+1);
      break;
    }
    case 'Renault': {
      ctx.fillStyle = style.fg; ctx.strokeStyle = style.stroke; ctx.lineWidth=Math.max(size*0.06,1);
      ctx.beginPath();
      ctx.moveTo(x, midY-r); ctx.lineTo(x+r*0.85, midY);
      ctx.lineTo(x, midY+r); ctx.lineTo(x-r*0.85, midY);
      ctx.closePath(); ctx.fill(); ctx.stroke();
      break;
    }
    case 'Hyundai': {
      ctx.fillStyle = style.bg;
      ctx.beginPath(); ctx.ellipse(x, midY, r*0.95, r*0.62, 0, 0, 2*Math.PI); ctx.fill();
      ctx.strokeStyle = style.fg; ctx.lineWidth=Math.max(size*0.1,1.5);
      // "H" estilizado e inclinado, remetendo ao simbolo da Hyundai
      ctx.beginPath();
      ctx.moveTo(x-r*0.38, midY+r*0.34); ctx.lineTo(x-r*0.22, midY-r*0.34);
      ctx.moveTo(x+r*0.38, midY-r*0.34); ctx.lineTo(x+r*0.22, midY+r*0.34);
      ctx.moveTo(x-r*0.30, midY); ctx.lineTo(x+r*0.30, midY);
      ctx.stroke();
      break;
    }
    case 'Jeep': {
      const gw=size*0.9, gh=size*0.5;
      ctx.fillStyle = style.bg;
      roundRect(ctx, x-gw/2, midY-gh/2, gw, gh, size*0.08); ctx.fill();
      ctx.strokeStyle = style.fg; ctx.lineWidth=Math.max(size*0.055,1);
      const slots=7;
      for(let i=1;i<slots;i++){
        const sx = x-gw/2 + gw*i/slots;
        ctx.beginPath(); ctx.moveTo(sx, midY-gh/2+2); ctx.lineTo(sx, midY+gh/2-2); ctx.stroke();
      }
      break;
    }
    case 'Honda': {
      const rr=size*0.16;
      ctx.fillStyle = style.bg;
      roundRect(ctx, x-r*0.85, midY-r*0.85, r*1.7, r*1.7, rr); ctx.fill();
      ctx.strokeStyle = style.fg; ctx.lineWidth=Math.max(size*0.11,1.6);
      ctx.beginPath();
      ctx.moveTo(x-r*0.36, midY-r*0.4); ctx.lineTo(x-r*0.36, midY+r*0.4);
      ctx.moveTo(x+r*0.36, midY-r*0.4); ctx.lineTo(x+r*0.36, midY+r*0.4);
      ctx.moveTo(x-r*0.36, midY); ctx.lineTo(x+r*0.36, midY);
      ctx.stroke();
      break;
    }
    case 'Nissan': {
      ctx.fillStyle = style.bg;
      ctx.beginPath(); ctx.arc(x, midY, r*0.92, 0, 2*Math.PI); ctx.fill();
      ctx.strokeStyle = style.fg; ctx.lineWidth=Math.max(size*0.07,1.2);
      ctx.beginPath(); ctx.arc(x, midY, r*0.78, 0, 2*Math.PI); ctx.stroke();
      ctx.fillStyle = style.fg;
      ctx.fillRect(x-r*0.62, midY-r*0.15, r*1.24, r*0.30);
      break;
    }
    case 'Ford': {
      ctx.fillStyle = style.bg;
      ctx.beginPath(); ctx.ellipse(x, midY, r*1.05, r*0.6, 0, 0, 2*Math.PI); ctx.fill();
      ctx.strokeStyle='#ffffff'; ctx.lineWidth=Math.max(size*0.04,1); ctx.stroke();
      ctx.fillStyle = style.fg;
      ctx.font = `italic bold ${Math.round(size*0.3)}px Georgia, serif`;
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText('Ford', x, midY+1);
      break;
    }
    default: {
      ctx.fillStyle = fallbackColor;
      ctx.beginPath(); ctx.arc(x, midY, r*0.9, 0, 2*Math.PI); ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = `bold ${Math.round(size*0.5)}px Segoe UI`;
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.fillText(brand.charAt(0), x, midY+1);
    }
  }
  ctx.restore();
}

/* ===================== CHART: LINHA (Faturamento/Qtd Mensal) ===================== */
function drawLineChart(canvas, labels, values, isCurrency){
  const ctx = canvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  const W = rect.width, H = rect.height || 260;
  canvas.width = W*dpr; canvas.height = H*dpr;
  ctx.setTransform(1,0,0,1,0,0);
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,W,H);

  if(values.length===0){
    ctx.fillStyle='#5b6b7f'; ctx.font='13px Segoe UI'; ctx.textAlign='center';
    ctx.fillText('Sem dados para o período selecionado', W/2, H/2);
    return;
  }

  const padL= isCurrency? 62:44, padR=16, padT=20, padB=38;
  const plotW = W-padL-padR, plotH = H-padT-padB;
  const maxV = Math.max(...values)*1.15 || 1;
  const minV = 0;

  ctx.strokeStyle='#e7edf5'; ctx.fillStyle='#5b6b7f'; ctx.font='11px Segoe UI';
  const ySteps=5;
  for(let i=0;i<=ySteps;i++){
    const y = padT + plotH - (plotH*i/ySteps);
    const val = maxV*i/ySteps;
    ctx.beginPath(); ctx.moveTo(padL,y); ctx.lineTo(W-padR,y); ctx.stroke();
    ctx.textAlign='right';
    ctx.fillText(isCurrency? (val/1000).toFixed(0)+'k' : val.toFixed(0), padL-8, y+4);
  }

  const stepX = labels.length>1? plotW/(labels.length-1) : 0;
  ctx.fillStyle='#5b6b7f'; ctx.font='10.5px Segoe UI';
  const skip = labels.length>10? 3 : (labels.length>6? 2:1);
  labels.forEach((lab,i)=>{
    if(i%skip===0 || i===labels.length-1){
      const x = padL + stepX*i;
      ctx.save(); ctx.translate(x, H-padB+16); ctx.textAlign='center';
      ctx.fillText(monthLabelPtBr(lab), 0, 0);
      ctx.restore();
    }
  });

  ctx.beginPath();
  values.forEach((v,i)=>{
    const x = padL + stepX*i;
    const y = padT + plotH - (plotH*(v-minV)/(maxV-minV));
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  });
  ctx.lineTo(padL+stepX*(values.length-1), padT+plotH);
  ctx.lineTo(padL, padT+plotH);
  ctx.closePath();
  const grad = ctx.createLinearGradient(0,padT,0,padT+plotH);
  grad.addColorStop(0,'rgba(30,111,217,0.35)');
  grad.addColorStop(1,'rgba(30,111,217,0.02)');
  ctx.fillStyle=grad; ctx.fill();

  ctx.beginPath();
  values.forEach((v,i)=>{
    const x = padL + stepX*i;
    const y = padT + plotH - (plotH*(v-minV)/(maxV-minV));
    if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
  });
  ctx.strokeStyle='#1e6fd9'; ctx.lineWidth=2.5; ctx.stroke();

  values.forEach((v,i)=>{
    const x = padL + stepX*i;
    const y = padT + plotH - (plotH*(v-minV)/(maxV-minV));
    ctx.beginPath(); ctx.arc(x,y,3.5,0,2*Math.PI);
    ctx.fillStyle='#fff'; ctx.fill();
    ctx.lineWidth=2; ctx.strokeStyle='#1e6fd9'; ctx.stroke();
  });
}

/* ===================== CHART: BARRA HORIZONTAL (Vendedor) ===================== */
function drawHBarChart(canvas, labels, values){
  const ctx = canvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  const W = rect.width, H = Math.max(rect.height, labels.length*38+20);
  canvas.style.height = H+'px';
  canvas.width = W*dpr; canvas.height = H*dpr;
  ctx.setTransform(1,0,0,1,0,0);
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,W,H);

  if(labels.length===0){
    ctx.fillStyle='#5b6b7f'; ctx.font='13px Segoe UI'; ctx.textAlign='center';
    ctx.fillText('Sem dados para o período selecionado', W/2, H/2);
    return;
  }

  const padL=Math.min(140, Math.max(80, W*0.34)), padR=40, padT=10, padB=10;
  const plotW = W-padL-padR, plotH = H-padT-padB;
  const maxV = Math.max(...values)*1.15 || 1;
  const gap = plotH/labels.length;
  const barH = gap*0.6;

  ctx.font='12px Segoe UI';
  const maxLabelW = padL-16;
  labels.forEach((lab,i)=>{
    const y = padT + gap*i + gap/2;
    const barW = plotW*(values[i]/maxV);

    ctx.fillStyle='#0f2544'; ctx.textAlign='right'; ctx.textBaseline='middle';
    let displayLab = lab;
    if(ctx.measureText(displayLab).width > maxLabelW){
      while(displayLab.length>1 && ctx.measureText(displayLab+'…').width > maxLabelW){
        displayLab = displayLab.slice(0,-1);
      }
      displayLab += '…';
    }
    ctx.fillText(displayLab, padL-12, y);

    const color = PALETTE[i % PALETTE.length];
    ctx.fillStyle=color;
    roundRect(ctx, padL, y-barH/2, Math.max(barW,2), barH, 4);
    ctx.fill();

    ctx.fillStyle='#0f2544'; ctx.textAlign='left'; ctx.font='bold 12px Segoe UI';
    ctx.fillText(values[i], padL+barW+8, y);
    ctx.font='12px Segoe UI';
  });
}

function roundRect(ctx,x,y,w,h,r){
  if(w<r*2) r=Math.max(w/2,0);
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}

/* ===================== CHART: BARRA VERTICAL (Marca) com silhueta ===================== */
function drawVBarChart(canvas, labels, values){
  const ctx = canvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  const W = rect.width, H = rect.height || 280;
  canvas.width = W*dpr; canvas.height = H*dpr;
  ctx.setTransform(1,0,0,1,0,0);
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,W,H);

  if(labels.length===0){
    ctx.fillStyle='#5b6b7f'; ctx.font='13px Segoe UI'; ctx.textAlign='center';
    ctx.fillText('Sem dados para o período selecionado', W/2, H/2);
    return;
  }

  const slotEstimate = (W-46)/labels.length;
  const padB = slotEstimate < 62 ? 92 : 78;
  const padL=36, padR=10, padT=26;
  const plotW = W-padL-padR, plotH = H-padT-padB;
  const maxV = Math.max(...values)*1.2 || 1;

  ctx.strokeStyle='#e7edf5'; ctx.fillStyle='#5b6b7f'; ctx.font='10.5px Segoe UI';
  const ySteps=5;
  for(let i=0;i<=ySteps;i++){
    const y = padT + plotH - (plotH*i/ySteps);
    const val = maxV*i/ySteps;
    ctx.beginPath(); ctx.moveTo(padL,y); ctx.lineTo(W-padR,y); ctx.stroke();
    ctx.textAlign='right';
    ctx.fillText(val.toFixed(0), padL-6, y+4);
  }

  const slot = plotW/labels.length;
  const barW = Math.min(slot*0.55, 46);
  const iconW = Math.min(slot*0.56, 32);
  const tight = slot < 62; // espaço apertado -> rotacionar labels

  labels.forEach((lab,i)=>{
    const x = padL + slot*i + (slot-barW)/2;
    const barH = plotH*(values[i]/maxV);
    const y = padT + plotH - barH;
    const color = PALETTE[i % PALETTE.length];
    ctx.fillStyle = color;
    roundRect(ctx, x, y, barW, Math.max(barH,2), 4);
    ctx.fill();

    ctx.fillStyle='#0f2544'; ctx.textAlign='center'; ctx.font='bold 12px Segoe UI';
    ctx.fillText(values[i], x+barW/2, y-6);

    // silhueta da logo da marca, com espaco de respiro abaixo do eixo (sem sobrepor a barra)
    const iconGap = 9;
    const iconBaselineY = padT + plotH + iconGap + iconW;
    drawBrandIcon(ctx, lab, padL+slot*i+slot/2, iconBaselineY, iconW, color);

    // nome da marca abaixo do icone (rotacionado se espaço apertado)
    ctx.font='10.5px Segoe UI'; ctx.fillStyle='#5b6b7f';
    ctx.save();
    if(tight){
      ctx.translate(padL+slot*i+slot/2+4, iconBaselineY+12);
      ctx.rotate(-Math.PI/4);
      ctx.textAlign='right';
      ctx.fillText(lab, 0, 0);
    } else {
      ctx.translate(padL+slot*i+slot/2, iconBaselineY+16);
      ctx.textAlign='center';
      ctx.fillText(lab, 0, 0);
    }
    ctx.restore();
  });
}

/* ===================== CHART: DONUT (Forma de Pagamento) ===================== */
function drawDonutChart(canvas, labels, values){
  const ctx = canvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.getBoundingClientRect();
  const W = rect.width || 200, H = rect.height || 200;
  canvas.width = W*dpr; canvas.height = H*dpr;
  ctx.setTransform(1,0,0,1,0,0);
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,W,H);

  const total = values.reduce((a,b)=>a+b,0);
  if(total===0){
    ctx.fillStyle='#5b6b7f'; ctx.font='12px Segoe UI'; ctx.textAlign='center';
    ctx.fillText('Sem dados', W/2, H/2);
    return;
  }

  const cx=W/2, cy=H/2, rOuter=Math.min(W,H)/2-6, rInner=rOuter*0.58;
  let startAngle=-Math.PI/2;

  values.forEach((v,i)=>{
    const angle = (v/total)*2*Math.PI;
    ctx.beginPath();
    ctx.moveTo(cx,cy);
    ctx.arc(cx,cy,rOuter,startAngle,startAngle+angle);
    ctx.closePath();
    ctx.fillStyle = PALETTE[i % PALETTE.length];
    ctx.fill();
    startAngle += angle;
  });

  ctx.beginPath();
  ctx.arc(cx,cy,rInner,0,2*Math.PI);
  ctx.fillStyle='#ffffff';
  ctx.fill();

  ctx.fillStyle='#0f2544'; ctx.textAlign='center';
  ctx.font='bold 19px Segoe UI';
  ctx.fillText(total, cx, cy-2);
  ctx.font='10.5px Segoe UI'; ctx.fillStyle='#5b6b7f';
  ctx.fillText('vendas', cx, cy+15);
}

function buildLegend(containerId, labels, values){
  const total = values.reduce((a,b)=>a+b,0);
  const container = document.getElementById(containerId);
  container.innerHTML='';
  if(total===0){
    container.innerHTML = '<div class="empty-msg">Sem dados para os filtros selecionados</div>';
    return;
  }
  labels.forEach((lab,i)=>{
    const pct = (values[i]/total*100).toFixed(1).replace('.',',');
    const item = document.createElement('div');
    item.className='legend-item';
    item.innerHTML = `
      <div class="legend-left">
        <span class="legend-dot" style="background:${PALETTE[i % PALETTE.length]}"></span>
        <span>${lab}</span>
      </div>
      <span class="legend-value">${values[i]} (${pct}%)</span>
    `;
    container.appendChild(item);
  });
}

/* ===================== AGREGACOES DINAMICAS ===================== */
function aggMonthly(filtered, metric){
  const map = {};
  MONTHS.forEach(m=>{ if(inMonthRange(m)) map[m]=0; });
  filtered.forEach(r=>{
    if(map[r.d]===undefined) return;
    map[r.d] += metric==='valor'? r.val : 1;
  });
  const labels = Object.keys(map);
  const values = labels.map(l=>map[l]);
  return {labels, values};
}

function aggVendedor(filtered){
  const map = {};
  filtered.forEach(r=>{ map[r.v] = (map[r.v]||0)+1; });
  const entries = Object.entries(map).sort((a,b)=>b[1]-a[1]);
  return {labels: entries.map(e=>e[0]), values: entries.map(e=>e[1])};
}

function aggPagamento(filtered){
  const map = {};
  filtered.forEach(r=>{ map[r.p] = (map[r.p]||0)+1; });
  const entries = Object.entries(map).sort((a,b)=>b[1]-a[1]);
  return {labels: entries.map(e=>e[0]), values: entries.map(e=>e[1])};
}

function aggMarca(filtered){
  const map = {};
  filtered.forEach(r=>{ map[r.m] = (map[r.m]||0)+1; });
  const entries = Object.entries(map).sort((a,b)=>b[1]-a[1]);
  return {labels: entries.map(e=>e[0]), values: entries.map(e=>e[1])};
}

/* ===================== RENDER ===================== */
function renderAll(){
  updateKPIs();
  const baseFiltered = byMonthRange();

  // Chart 1: Evolução Mensal
  const monthly = aggMonthly(baseFiltered, state.lineMetric);
  drawLineChart(document.getElementById('chartMensal'), monthly.labels, monthly.values, state.lineMetric==='valor');

  // Chart 2: Vendedor (filtro adicional por marca)
  let vendData = baseFiltered;
  if(state.vendedorMarca) vendData = vendData.filter(r=>r.m===state.vendedorMarca);
  const vend = aggVendedor(vendData);
  drawHBarChart(document.getElementById('chartVendedor'), vend.labels, vend.values);

  // Chart 3: Forma de Pagamento (filtro adicional por condicao)
  let pagData = baseFiltered;
  if(state.pagamentoCondicao) pagData = pagData.filter(r=>r.c===state.pagamentoCondicao);
  const pag = aggPagamento(pagData);
  drawDonutChart(document.getElementById('chartPagamento'), pag.labels, pag.values);
  buildLegend('legendPagamento', pag.labels, pag.values);

  // Chart 4: Marca (filtro adicional por tipo)
  let marcaData = baseFiltered;
  if(state.marcaTipo) marcaData = marcaData.filter(r=>r.t===state.marcaTipo);
  const marca = aggMarca(marcaData);
  drawVBarChart(document.getElementById('chartMarca'), marca.labels, marca.values);
}

/* ===================== EVENTOS ===================== */
function setupEvents(){
  document.getElementById('monthFrom').addEventListener('change', (e)=>{
    state.monthFrom = e.target.value;
    if(state.monthFrom > state.monthTo){ state.monthTo = state.monthFrom; document.getElementById('monthTo').value = state.monthTo; }
    renderAll();
  });
  document.getElementById('monthTo').addEventListener('change', (e)=>{
    state.monthTo = e.target.value;
    if(state.monthTo < state.monthFrom){ state.monthFrom = state.monthTo; document.getElementById('monthFrom').value = state.monthFrom; }
    renderAll();
  });

  document.querySelectorAll('#lineMetricToggle .toggle-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('#lineMetricToggle .toggle-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      state.lineMetric = btn.dataset.metric;
      renderAll();
    });
  });

  document.getElementById('filterVendedorMarca').addEventListener('change', (e)=>{
    state.vendedorMarca = e.target.value;
    renderAll();
  });
  document.getElementById('filterPagamentoCondicao').addEventListener('change', (e)=>{
    state.pagamentoCondicao = e.target.value;
    renderAll();
  });
  document.getElementById('filterMarcaTipo').addEventListener('change', (e)=>{
    state.marcaTipo = e.target.value;
    renderAll();
  });

  document.getElementById('resetBtn').addEventListener('click', ()=>{
    state.monthFrom = MONTHS[0];
    state.monthTo = MONTHS[MONTHS.length-1];
    state.lineMetric = 'valor';
    state.vendedorMarca = '';
    state.pagamentoCondicao = '';
    state.marcaTipo = '';

    document.getElementById('monthFrom').value = state.monthFrom;
    document.getElementById('monthTo').value = state.monthTo;
    document.getElementById('filterVendedorMarca').value = '';
    document.getElementById('filterPagamentoCondicao').value = '';
    document.getElementById('filterMarcaTipo').value = '';
    document.querySelectorAll('#lineMetricToggle .toggle-btn').forEach(b=>b.classList.remove('active'));
    document.querySelector('#lineMetricToggle .toggle-btn[data-metric="valor"]').classList.add('active');

    renderAll();
  });

  let resizeTimer;
  window.addEventListener('resize', ()=>{
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(renderAll, 150);
  });
}

/* ===================== INIT ===================== */
populateMonthSelects();
populateFilterSelects();
setupEvents();
renderAll();
</script>
